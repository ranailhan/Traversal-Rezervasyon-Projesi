@model List<AppUser>
@{
	ViewData["Title"] = "Index";
	Layout = "~/Views/Shared/_AdminLayout.cshtml";
	int sayac = 0;
}

<h1>Kullanıcı Listesi</h1>

<table class="table bordered">
	<tr>
		<th>#</th>
		<th>Ad Soyad</th>
		<th>Kullanıcı Adı</th>
		<th>Mail Adresi</th>
		<th>Sil</th>
		<th>Düzenle</th>
		<th>Yorumlar</th>
		<th>Tur Geçmişi</th>
	</tr>
	@foreach (var user in Model)
	{
		sayac = sayac + 1;
		<tr>
			<td>@sayac</td>
			<td>@user.Name @user.Surname</td>
			<td>@user.UserName</td>
			<td>@user.Email</td>
			<td><a href="/Admin/User/DeleteUser/@user.Id" class="btn btn-outline-danger">Sil</a></td> @* TODO: Bütün sayfalara modal eklenecek sil için *@
			<td><a href="/Admin/User/EditUser/@user.Id" " class="btn btn-outline-success">Düzenle</a></td>
			<td><a href="/Admin/User/CommentUser/@user.Id" " class="btn btn-outline-info">Yorumlar</a></td>
			<td><a href="/Admin/User/UserTourHistory/@user.Id" " class="btn btn-outline-secondary">Tur Geçmişi</a></td>
		</tr>
	}
</table>

<a href="/Login/SignUp/" class="btn btn-outline-primary"></a> @* TODO: admin panelinden de kullanıcı oluşturulabilir mi? *@
