@model Traversal.Models.MailRequest;
@{
	ViewData["Title"] = "Index";
	Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<h1>Yeni Mail Gönderme Sayfası</h1>
<form method="post">
	<div class="text-danger" asp-validation-summary="ModelOnly">
	</div>
	<div class="form-group">
		@Html.Label("Alıcı Mail Adresi:")
		<input type="text" asp-for="MailReceiver" class="form-control" />
	</div>
	<div class="form-group">
		@Html.Label("Mail Konusu:")
		<input type="text" asp-for="Subject" class="form-control" />
	</div>
	<div class="form-group">
		@Html.Label("Mail İçeriği")
		<input type="text" asp-for="Body" class="form-control" />
	</div>
	<div class="form-group">
		<button class="btn btn-outline-success">Mail Gönder</button>
	</div>
</form>



