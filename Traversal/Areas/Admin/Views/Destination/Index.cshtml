@using EntityLayer.Concrete
@model List<Destination>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1>Tur Rotaları</h1>
<table class="table table-bordered">
    <tr>
        <th>#</th>
        <th>Şehir</th>
        <th>Fiyat</th>
        <th>Kapasite</th>
        <th>Sitede Gör</th>
        <th>Sil</th>
        <th>Güncelle</th>
@*         <th>Detaylar</th>
 *@    </tr>
    @foreach(var destination in Model)
    {
        <tr>
            <td>@destination.DestinationID</td>
            <td>@destination.City</td>
            <td>@destination.Price</td>
            <td>@destination.Capacity</td>
            <td><a href="/Destination/DestinationDetails/@destination.DestinationID" class="btn btn-outline-info">Sitede Gör</a></td>
            <td><a href="/Admin/Destination/DeleteDestination/@destination.DestinationID" class="btn btn-outline-danger">Sil</a></td>
            <td><a href="/Admin/Destination/UpdateDestination/@destination.DestinationID" class="btn btn-outline-success">Güncelle</a></td>
@*             <td><a href="#" class="btn btn-outline-primary">Detaylar</a></td>
 *@        </tr>
    }
</table>
<a href="/Admin/Destination/AddDestination" class="btn btn-primary">Yeni Tur Rotası</a>

